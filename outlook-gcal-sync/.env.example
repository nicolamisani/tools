# --- Web UI ---------------------------------------------------------------
# Password for the web UI. STRONGLY recommended: this app holds an OAuth
# refresh token for your Google Calendar. Leave empty only if the app is
# bound to localhost and nothing else can reach it.
APP_PASSWORD=

# Public base URL of this app. Must match the redirect URI you register in
# Google Cloud Console, which is: <APP_BASE_URL>/oauth/google/callback
APP_BASE_URL=http://localhost:8080

# --- Google OAuth client (Google Cloud Console -> Credentials -> Web app) --
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Storage --------------------------------------------------------------
# Directory for the SQLite database and the token-encryption key.
DATA_DIR=./data
